<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ allowlist-only Cloud Backup and Device-to-Device transfer rules: includes ONLY non-secret kitchen_snapshot_v1.json. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="file" path="kitchen_snapshot_v1.json" />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="kitchen_snapshot_v1.json" />
  </device-transfer>
</data-extraction-rules>
